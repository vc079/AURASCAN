# Copy to .env and fill in real values. Never commit .env.

DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inspiro_db
ALLOWED_HOST=localhost:3000

# Required by GET /api/export/logs. If unset, the endpoint fails closed with 503.
# Use a long random value, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=

# Row caps for the CSV export.
EXPORT_DEFAULT_LIMIT=1000
EXPORT_MAX_LIMIT=50000
